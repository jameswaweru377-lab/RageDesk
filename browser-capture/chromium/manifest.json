{
  "manifest_version": 3,
  "name": "RangeDesk Browser Capture",
  "version": "0.5.0",
  "description": "Opt-in browser downloads and in-page HTML5 video download control for exposed direct media sources.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RangeDesk — click to enable automatic capture"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video-sources.js",
        "video-overlay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
