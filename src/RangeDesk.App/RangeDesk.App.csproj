<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RangeDesk</AssemblyName>
    <Version>0.8.0-preview.2</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RangeDesk.Core\RangeDesk.Core.csproj" />
    <!-- Lightweight shared Evergreen WebView2 Runtime: no Electron or fixed Chromium payload. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- CI builds Vite before publish. WPF works normally even when dist is absent locally. -->
    <Content Include="..\..\frontend\dist\**\*"
             Link="web\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
