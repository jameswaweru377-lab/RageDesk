<UserControl x:Class="RangeDesk.App.Views.V5Workspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RangeDesk.App.Views"
             Foreground="#F1F7FF" Background="#071525" FontFamily="Segoe UI">
  <UserControl.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/RangeDesk.App;component/Themes/V5Theme.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary></UserControl.Resources>
  <Grid Background="{StaticResource V5CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource V5SidebarBrush}" BorderBrush="{StaticResource V5OutlineBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
      <DockPanel Margin="12,15,9,12">
        <TextBlock DockPanel.Dock="Bottom" Text="RangeDesk · local downloads" FontSize="10" Foreground="{StaticResource V5MutedBrush}" Margin="9,12,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid Margin="8,3,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="◈  RangeDesk" FontWeight="SemiBold" FontSize="20"/>
              <Button Grid.Column="1" Content="☰" Click="CollapseNav_Click" Style="{StaticResource V5NavButton}" ToolTip="Collapse or expand navigation"/>
            </Grid>
            <Button Command="{Binding ShowDownloadsCommand}" Content="⇩   Downloads" Style="{StaticResource V5NavButton}" ToolTip="Downloads"/>
            <Button Command="{Binding ShowCompletedCommand}" Content="✓   Completed" Style="{StaticResource V5NavButton}" ToolTip="Completed"/>
            <Button Command="{Binding ShowQueueCommand}" Content="☷   Queue" Style="{StaticResource V5NavButton}" ToolTip="Queue"/>
            <Button Content="◷   Scheduled" Style="{StaticResource V5NavButton}" IsEnabled="False" ToolTip="Scheduled downloads — planned"/>
            <Border Height="1" Background="{StaticResource V5OutlineBrush}" Margin="4,16,4,12"/>
            <TextBlock Text="CATEGORIES" Foreground="{StaticResource V5MutedBrush}" FontSize="10" Margin="12,0,0,8"/>
            <Button Content="▣   Software" IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Categories — planned"/>
            <Button Content="▷   Videos" IsEnabled="False" Style="{StaticResource V5NavButton}"/>
            <Button Content="▤   Documents" IsEnabled="False" Style="{StaticResource V5NavButton}"/>
            <Button Content="▧   Archives" IsEnabled="False" Style="{StaticResource V5NavButton}"/>
            <Border Height="1" Background="{StaticResource V5OutlineBrush}" Margin="4,16,4,12"/>
            <TextBlock Text="LABELS" Foreground="{StaticResource V5MutedBrush}" FontSize="10" Margin="12,0,0,8"/>
            <Button Content="●   Work" IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Labels — planned"/>
            <Button Content="●   Personal" IsEnabled="False" Style="{StaticResource V5NavButton}"/>
            <Button Content="●   Important" IsEnabled="False" Style="{StaticResource V5NavButton}"/>
            <Border Height="1" Background="{StaticResource V5OutlineBrush}" Margin="4,16,4,12"/>
            <Button Content="⊕   Site presets" IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Site presets — planned"/>
            <Button Content="⚡   Automation" IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Automation — planned"/>
            <Button Command="{Binding ShowSettingsCommand}" Content="⚙   Settings" Style="{StaticResource V5NavButton}" ToolTip="Settings"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="14,13,15,11">
      <Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource V5SurfaceBrush}" BorderBrush="{StaticResource V5OutlineBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,0,9" Padding="9,4">
        <DockPanel LastChildFill="True">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="+  Add Download" Command="{Binding ToggleAddCommand}" Style="{StaticResource V5PrimaryButton}"/>
            <Button Content="▶  Resume" Command="{Binding ResumeCommand}" Style="{StaticResource V5ToolbarButton}"/>
            <Button Content="Ⅱ  Pause" Command="{Binding PauseCommand}" Style="{StaticResource V5ToolbarButton}"/>
            <Button Content="■  Stop" Command="{Binding CancelCommand}" Style="{StaticResource V5ToolbarButton}"/>
          </StackPanel>
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="285" HorizontalAlignment="Left"
                   ToolTip="Search download name or source host" Style="{StaticResource V5Input}"/>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Visibility="{Binding IsListPage, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/>
            <Border Background="{StaticResource V5SelectedBrush}" CornerRadius="10" Padding="8,3" Margin="10,2,0,0">
              <TextBlock Text="{Binding DownloadsCount}" Foreground="{StaticResource V5AccentLightBrush}" FontSize="11"/>
            </Border>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Real-time transfer activity" VerticalAlignment="Center" Foreground="{StaticResource V5MutedBrush}"/>
        </Grid>
        <views:CompactDownloadsView Grid.Row="1"/>
      </Grid>
      <Border Grid.Row="1" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Top"
              Background="{StaticResource V5SurfaceBrush}" BorderBrush="{StaticResource V5OutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="23">
        <StackPanel Width="445" HorizontalAlignment="Left">
          <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,20"/>
          <TextBlock Text="Connections per download (1–8)"/><TextBox Text="{Binding Connections, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource V5Input}" Margin="0,7,0,16"/>
          <TextBlock Text="Simultaneous downloads (1–4)"/><TextBox Text="{Binding Simultaneous, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource V5Input}" Margin="0,7,0,16"/>
          <TextBlock Text="Download speed limit (KiB/s; 0 = unlimited)"/><TextBox Text="{Binding SpeedLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource V5Input}" Margin="0,7,0,16"/>
          <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource V5PrimaryButton}" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding SettingsMessage}" Foreground="{StaticResource V5SuccessBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource V5DangerBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </Grid>

    <Grid Grid.ColumnSpan="2" Panel.ZIndex="8" Background="#B0031020"
          Visibility="{Binding IsAddPanelOpen, Converter={StaticResource BoolVisibility}}">
      <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20"
              Background="{StaticResource V5ElevatedBrush}" BorderBrush="{StaticResource V5AccentBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="New Download" FontWeight="SemiBold" FontSize="20"/>
            <Button Grid.Column="1" Content="✕" Command="{Binding ToggleAddCommand}" Style="{StaticResource V5ToolbarButton}"/>
          </Grid>
          <TabControl Background="{StaticResource V5ElevatedBrush}" Foreground="{StaticResource V5TextBrush}" BorderThickness="0">
            <TabItem Header="General">
              <StackPanel Margin="8,13,8,4">
                <TextBlock Text="Download URL" Foreground="{StaticResource V5MutedBrush}"/>
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource V5Input}" Margin="0,6,0,13"/>
                <TextBlock Text="Save as (full destination path)" Foreground="{StaticResource V5MutedBrush}"/>
                <Grid Margin="0,6,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource V5Input}"/>
                  <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Style="{StaticResource V5ToolbarButton}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="Expected SHA-256 (optional)" Foreground="{StaticResource V5MutedBrush}"/>
                <TextBox Text="{Binding ExpectedSha256, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource V5Input}" Margin="0,6,0,11"/>
                <CheckBox Content="Resume matching paused or canceled download" IsChecked="{Binding ResumePrevious}" Foreground="{StaticResource V5TextBrush}"/>
              </StackPanel>
            </TabItem>
            <TabItem Header="Advanced">
              <TextBlock Text="Connections and bandwidth limits are currently configured in Settings. Per-download overrides are planned." TextWrapping="Wrap" Margin="12"/>
            </TabItem>
            <TabItem Header="Rules (planned)" IsEnabled="False"/>
            <TabItem Header="Automation (planned)" IsEnabled="False"/>
          </TabControl>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
            <Button Content="Cancel" Command="{Binding ToggleAddCommand}" Style="{StaticResource V5ToolbarButton}"/>
            <Button Content="▶  Start Download" Command="{Binding AddCommand}" Style="{StaticResource V5PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>