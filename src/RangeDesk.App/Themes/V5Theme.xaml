<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- RangeDesk v5 approved navy/azure theme tokens. -->
  <SolidColorBrush x:Key="V5CanvasBrush" Color="#071525"/>
  <SolidColorBrush x:Key="V5SidebarBrush" Color="#071629"/>
  <SolidColorBrush x:Key="V5SurfaceBrush" Color="#0B1C33"/>
  <SolidColorBrush x:Key="V5ElevatedBrush" Color="#102641"/>
  <SolidColorBrush x:Key="V5SelectedBrush" Color="#123963"/>
  <SolidColorBrush x:Key="V5OutlineBrush" Color="#214262"/>
  <SolidColorBrush x:Key="V5AccentBrush" Color="#087EF2"/>
  <SolidColorBrush x:Key="V5AccentLightBrush" Color="#20A4FF"/>
  <SolidColorBrush x:Key="V5TextBrush" Color="#F1F7FF"/>
  <SolidColorBrush x:Key="V5MutedBrush" Color="#8DAFCB"/>
  <SolidColorBrush x:Key="V5SuccessBrush" Color="#12CC9C"/>
  <SolidColorBrush x:Key="V5WarningBrush" Color="#FF9B37"/>
  <SolidColorBrush x:Key="V5DangerBrush" Color="#EF5B67"/>
  <Style x:Key="V5ToolbarButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource V5ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource V5SelectedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5PrimaryButton" TargetType="Button" BasedOn="{StaticResource V5ToolbarButton}">
    <Setter Property="Background" Value="{StaticResource V5AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="V5NavButton" TargetType="Button" BasedOn="{StaticResource V5ToolbarButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Padding" Value="13,10"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="V5Input" TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource V5SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
</ResourceDictionary>