<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Live Cobalt Flow / Arctic Light resources (Cobalt is default). -->
  <SolidColorBrush x:Key="V5CanvasBrush" Color="#05172F"/>
  <SolidColorBrush x:Key="V5SidebarBrush" Color="#071A33"/>
  <SolidColorBrush x:Key="V5SurfaceBrush" Color="#0B213D"/>
  <SolidColorBrush x:Key="V5ElevatedBrush" Color="#0F2B4D"/>
  <SolidColorBrush x:Key="V5SelectedBrush" Color="#153C6D"/>
  <SolidColorBrush x:Key="V5OutlineBrush" Color="#21476E"/>
  <SolidColorBrush x:Key="V5AccentBrush" Color="#147DF3"/>
  <SolidColorBrush x:Key="V5AccentLightBrush" Color="#58B8FF"/>
  <SolidColorBrush x:Key="V5TextBrush" Color="#F0F6FF"/>
  <SolidColorBrush x:Key="V5MutedBrush" Color="#9AB5D2"/>
  <SolidColorBrush x:Key="V5SuccessBrush" Color="#43D9A4"/>
  <SolidColorBrush x:Key="V5WarningBrush" Color="#F0BE73"/>
  <SolidColorBrush x:Key="V5DangerBrush" Color="#F18BA0"/>
  <!-- Theme-aware premium surfaces retain the existing Arctic light switch. -->
  <Color x:Key="V5PremiumToolbarTop">#12355E</Color>
  <Color x:Key="V5PremiumToolbarBottom">#091B34</Color>
  <Color x:Key="V5PremiumPrimaryTop">#32B6FF</Color>
  <Color x:Key="V5PremiumPrimaryBottom">#0762F2</Color>
  <LinearGradientBrush x:Key="V5PremiumToolbarFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{DynamicResource V5PremiumToolbarTop}" Offset="0"/>
    <GradientStop Color="{DynamicResource V5PremiumToolbarBottom}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="V5PremiumPrimaryFill" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{DynamicResource V5PremiumPrimaryTop}" Offset="0"/>
    <GradientStop Color="{DynamicResource V5PremiumPrimaryBottom}" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="V5ToolbarButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource V5ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5PrimaryButton" TargetType="Button" BasedOn="{StaticResource V5ToolbarButton}">
    <Setter Property="Background" Value="{DynamicResource V5AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="ArcticPanel" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource V5SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="V5NavButton" TargetType="Button" BasedOn="{StaticResource V5ToolbarButton}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="V5Input" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource V5SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Remove operating-system light chrome: WPF's default ComboBox and TabItem
       templates produced white surfaces against the navy workspace. -->
  <Style x:Key="V5ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource V5SurfaceBrush}"/>
    <Setter Property="Padding" Value="11,9"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Choice" CornerRadius="4" Margin="3,1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Choice" Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Choice" Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5Combo" TargetType="ComboBox">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource V5ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5OutlineBrush}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource V5ComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
            <ContentPresenter IsHitTestVisible="False" Margin="11,0,30,0" HorizontalAlignment="Left" VerticalAlignment="Center"
              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Path IsHitTestVisible="False" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource V5MutedBrush}" StrokeThickness="1.5"
              Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
            <ToggleButton Focusable="False" Background="Transparent" Opacity="0"
              BorderThickness="0" ClickMode="Press"
              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
              AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource V5SurfaceBrush}" MinWidth="{Binding ActualWidth, ElementName=Root}"
                BorderBrush="{DynamicResource V5OutlineBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                <ScrollViewer MaxHeight="290" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource V5AccentLightBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5TabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource V5MutedBrush}"/>
    <Setter Property="Padding" Value="15,10"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Chrome" CornerRadius="4,4,0,0" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
            <StackPanel>
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
              <Border x:Name="Indicator" Height="2" Margin="0,7,0,0" Background="Transparent"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
              <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource V5AccentLightBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.34"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5TabControl" TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource V5SurfaceBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource V5TabItem}"/>
  </Style>
  <Style x:Key="V5Progress" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource V5AccentLightBrush}"/>
    <Setter Property="Background" Value="{DynamicResource FlowBackgroundE5EEF9}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="7"/>
  </Style>

  <!-- Windows 11/10 native vector glyph font: no online icon assets or extra dependency. -->
  <FontFamily x:Key="V5IconFont">Segoe MDL2 Assets</FontFamily>

  <!-- WPF system theme must NEVER recolor a selected row white. -->
  <Style x:Key="V5GridCell" TargetType="{x:Type DataGridCell}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DataGridCell}">
          <Border x:Name="CellBackground" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource V5OutlineBrush}" BorderThickness="0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="CellBackground" Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5GridRow" TargetType="{x:Type DataGridRow}">
    <Setter Property="Background" Value="{DynamicResource V5SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource V5SelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource V5ElevatedBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="V5GridText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource V5TextBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="V5ProgressFixed" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="7"/>
    <Setter Property="Background" Value="{DynamicResource FlowBackgroundE5EEF9}"/>
    <Setter Property="Foreground" Value="{DynamicResource V5AccentLightBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                      CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="MinWidth" Value="24"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The downloads workspace, sidebar, dialog and settings share Arctic tokens. -->
  <SolidColorBrush x:Key="V5LightCanvas" Color="#071B36"/>
  <SolidColorBrush x:Key="V5LightSurface" Color="#0B213D"/>
  <SolidColorBrush x:Key="V5LightBorder" Color="#21476E"/>
  <SolidColorBrush x:Key="V5LightText" Color="#F0F6FF"/>
  <SolidColorBrush x:Key="V5LightMuted" Color="#9AB5D2"/>
  <SolidColorBrush x:Key="V5LightSelected" Color="#153C6D"/>
  <SolidColorBrush x:Key="V5LightBlue" Color="#319DFF"/>
  <Style x:Key="V5LightToolbarButton" TargetType="{x:Type Button}">
    <Setter Property="Padding" Value="13,9"/>
    <Setter Property="Foreground" Value="{DynamicResource V5LightText}"/>
    <Setter Property="Background" Value="{DynamicResource V5PremiumToolbarFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5LightBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="LightChrome" Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
             Padding="{TemplateBinding Padding}" CornerRadius="9">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="LightChrome" Property="Background" Value="{DynamicResource V5LightSelected}"/>
              <Setter TargetName="LightChrome" Property="BorderBrush" Value="{DynamicResource V5AccentLightBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.43"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5LightPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource V5LightToolbarButton}">
    <Setter Property="Background" Value="{DynamicResource V5PremiumPrimaryFill}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5AccentLightBrush}"/>
  </Style>
  <Style x:Key="V5LightTabButton" TargetType="{x:Type Button}" BasedOn="{StaticResource V5LightToolbarButton}">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5LightBorder}"/>
    <Setter Property="Background" Value="{DynamicResource FlowBackgroundF1F7FE}"/>
    <Setter Property="Padding" Value="13,8"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style x:Key="V5LightGridRow" TargetType="{x:Type DataGridRow}">
    <Setter Property="Height" Value="44"/>
    <Setter Property="Background" Value="{DynamicResource V5LightSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource V5LightText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FlowBorderBrushE2EAF5}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource FlowBackgroundF2F8FF}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource V5LightSelected}"/>
        <Setter Property="Foreground" Value="{DynamicResource V5LightText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="V5LightGridCell" TargetType="{x:Type DataGridCell}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource V5LightText}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DataGridCell}">
          <Border x:Name="SelectedCell" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedCell" Property="Background" Value="{DynamicResource V5LightSelected}"/>
              <Setter Property="Foreground" Value="{DynamicResource V5LightText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5LightHeader" TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Background" Value="{DynamicResource FlowBackgroundF5F9FE}"/>
    <Setter Property="Foreground" Value="{DynamicResource V5LightMuted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FlowBorderBrushE2EAF5}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8,7"/>
  </Style>
  <Style x:Key="V5LightGridText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource V5LightText}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="V5LightProgress" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="7"/>
    <Setter Property="Background" Value="{DynamicResource FlowBackgroundE5EEF9}"/>
    <Setter Property="Foreground" Value="{DynamicResource V5LightBlue}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid ClipToBounds="True">
            <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}" CornerRadius="4"/>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="V5MetricCard" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource V5ElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource V5OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
