<Window x:Class="RangeDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:charts="clr-namespace:RangeDesk.App.Controls"
        Title="RangeDesk" Width="1480" Height="900" MinWidth="1030" MinHeight="630"
        Background="{StaticResource V5CanvasBrush}" Foreground="{StaticResource V5TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <charts:LightStatusBackgroundConverter x:Key="LightStatusBackground"/>
    <charts:LightStatusTextConverter x:Key="LightStatusText"/>
    <charts:DownloadActionGlyphConverter x:Key="DownloadActionGlyph"/>
    <charts:FileIconConverter x:Key="FileIcon"/>
    <charts:FileIconColorConverter x:Key="FileIconColor"/>
    <charts:StatusColorConverter x:Key="StatusColor"/>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="{StaticResource V5SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="BorderBrush" Value="{StaticResource V5OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource V5SelectedBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource V5SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource V5MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource V5OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="10,12"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource V5TabItem}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource V5ComboItem}"/>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource V5SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource V5OutlineBrush}"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource V5TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <!-- LEFT NAVIGATION: approved visual hierarchy -->
    <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource V5SidebarBrush}" BorderBrush="{StaticResource V5OutlineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,14,10,11">
        <Button DockPanel.Dock="Bottom" Style="{StaticResource V5NavButton}" Click="Settings_Click" ToolTip="Settings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="{StaticResource V5IconFont}" Foreground="#96B3D0" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Settings" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel></Grid></Button>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="7,4,0,18">
              <Button x:Name="SidebarToggle" Content="☰" ToolTip="Collapse or expand navigation" Click="ToggleSidebar_Click" Style="{StaticResource V5NavButton}" FontSize="14" Padding="5" Margin="0,0,7,0"/>
              <Border x:Name="SidebarBrandIcon" Background="{StaticResource V5AccentBrush}" CornerRadius="8" Width="33" Height="33">
                <TextBlock Text="↓" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="SidebarBrand" Text="RangeDesk" Margin="9,0,0,0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Tag="all" Click="Navigation_Click" Style="{StaticResource V5NavButton}" Background="{StaticResource V5SelectedBrush}" ToolTip="Downloads"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE896;" FontFamily="{StaticResource V5IconFont}" Foreground="#31AAFF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Downloads" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding DownloadsCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="completed" Click="Navigation_Click" Style="{StaticResource V5NavButton}" ToolTip="Completed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE73E;" FontFamily="{StaticResource V5IconFont}" Foreground="#54D5B2" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Completed" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding CompletedCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="queue" Click="Navigation_Click" Style="{StaticResource V5NavButton}" ToolTip="Queue"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8FD;" FontFamily="{StaticResource V5IconFont}" Foreground="#C0CBE0" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Queue" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding QueueCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Scheduled"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE823;" FontFamily="{StaticResource V5IconFont}" Foreground="#8DAFCB" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Scheduled (planned)" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel></Grid></Button>
            <Border Height="1" Margin="4,8,4,9" Background="{StaticResource V5OutlineBrush}"/>
            <TextBlock Text="CATEGORIES" Margin="12,0,0,5" Foreground="{StaticResource V5MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
            <Button Tag="all" Click="Navigation_Click" Style="{StaticResource V5NavButton}" ToolTip="All Downloads"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8A9;" FontFamily="{StaticResource V5IconFont}" Foreground="#9FCFFF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="All Downloads" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding DownloadsCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Software" Click="Category_Click" Style="{StaticResource V5NavButton}" ToolTip="Software"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource V5IconFont}" Foreground="#4CB5FF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Software" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding SoftwareCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Videos" Click="Category_Click" Style="{StaticResource V5NavButton}" ToolTip="Videos"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE714;" FontFamily="{StaticResource V5IconFont}" Foreground="#B875FF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Videos" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding VideosCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Documents" Click="Category_Click" Style="{StaticResource V5NavButton}" ToolTip="Documents"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8A5;" FontFamily="{StaticResource V5IconFont}" Foreground="#8DB9FF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Documents" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding DocumentsCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Archives" Click="Category_Click" Style="{StaticResource V5NavButton}" ToolTip="Archives"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="{StaticResource V5IconFont}" Foreground="#FFB343" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Archives" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding ArchivesCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Images" Click="Category_Click" Style="{StaticResource V5NavButton}" ToolTip="Images"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE91B;" FontFamily="{StaticResource V5IconFont}" Foreground="#46DCA7" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Images" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding ImagesCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Border Height="1" Margin="4,8,4,9" Background="{StaticResource V5OutlineBrush}"/>
            <TextBlock Text="LABELS" Margin="12,0,0,5" Foreground="{StaticResource V5MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
            <Button Tag="Work" Click="Label_Click" Style="{StaticResource V5NavButton}" ToolTip="Work"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8F9;" FontFamily="{StaticResource V5IconFont}" Foreground="#2DAAFF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Work" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding WorkCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Personal" Click="Label_Click" Style="{StaticResource V5NavButton}" ToolTip="Personal"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource V5IconFont}" Foreground="#B577FC" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Personal" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding PersonalCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Button Tag="Important" Click="Label_Click" Style="{StaticResource V5NavButton}" ToolTip="Important"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE7BA;" FontFamily="{StaticResource V5IconFont}" Foreground="#FFAB4A" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Important" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Column="1" Tag="NavBadge" Background="#163656" Padding="5,2" CornerRadius="6" Margin="4,0,1,0" MinWidth="23"><TextBlock Text="{Binding ImportantCount}" HorizontalAlignment="Center" Foreground="{StaticResource V5AccentLightBrush}" FontSize="10"/></Border></Grid></Button>
            <Border Height="1" Margin="4,8,4,9" Background="{StaticResource V5OutlineBrush}"/>
            <TextBlock Text="SITE PRESETS" Margin="12,0,0,5" Foreground="{StaticResource V5MutedBrush}" FontSize="10" FontWeight="SemiBold"/>
            <Button IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Site presets"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE774;" FontFamily="{StaticResource V5IconFont}" Foreground="#64BAFF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Site presets (planned)" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel></Grid></Button>
            <Button IsEnabled="False" Style="{StaticResource V5NavButton}" ToolTip="Automation"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="{StaticResource V5IconFont}" Foreground="#8CC7FF" FontSize="17" VerticalAlignment="Center" Width="26"/><TextBlock Tag="NavCaption" Text="Automation (planned)" Foreground="{StaticResource V5TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel></Grid></Button>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- RIGHT WORKSPACE: the downloads surface uses navy theme. Sidebar and
         transfer inspector retain their existing dark layout unmodified. -->
    <Grid Grid.Column="1" Margin="15,12,15,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="122"/>
        <RowDefinition Height="57"/>
        <RowDefinition Height="*" MinHeight="75"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Grid.RowSpan="4" Background="{StaticResource V5LightCanvas}" CornerRadius="11" Margin="0,0,0,0"/>

      <!-- Navy command/header with genuine local mode (no false cloud sync). -->
      <Border Grid.Row="0" Background="{StaticResource V5LightSurface}" CornerRadius="10,10,0,0"
              BorderBrush="{StaticResource V5LightBorder}" BorderThickness="0,0,0,1" Padding="13,6">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="#122B48" BorderBrush="{StaticResource V5LightBorder}" BorderThickness="1"
                  CornerRadius="7" Height="34" MaxWidth="540" HorizontalAlignment="Stretch">
            <Grid Margin="11,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource V5IconFont}" Foreground="{StaticResource V5LightMuted}" VerticalAlignment="Center" FontSize="13"/>
              <TextBox x:Name="GlobalSearch" Grid.Column="1" Background="Transparent" Foreground="{StaticResource V5LightText}"
                       BorderThickness="0" VerticalContentAlignment="Center" FontSize="12"
                       TextChanged="Search_Changed" KeyDown="Search_KeyDown" ToolTip="Search downloads or paste a URL and press Enter"/>
              <TextBlock x:Name="SearchHint" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center"
                         Foreground="{StaticResource V5LightMuted}" FontSize="11" Text="Search downloads, files, or paste links..."/>
              <Border Grid.Column="2" Background="#1C3554" CornerRadius="4" Padding="6,3" Margin="5,0,0,0"
                      VerticalAlignment="Center"><TextBlock Text="Ctrl + L" Foreground="{StaticResource V5LightMuted}" FontSize="9"/></Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Border Background="#173453" CornerRadius="6" Padding="8,5" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource V5IconFont}" Text="&#xE753;" Foreground="#49AEFF" Margin="0,0,5,0"/>
                <TextBlock Text="Local only" FontSize="10" Foreground="{StaticResource V5LightMuted}"/>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource V5LightToolbarButton}" Click="Settings_Click" ToolTip="Settings" Padding="9,6">
              <TextBlock Text="&#xE713;" FontFamily="{StaticResource V5IconFont}" Foreground="{StaticResource V5LightText}" FontSize="15"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Greeting and metrics; vector scenery drawn locally, no online asset. -->
      <Border Grid.Row="1" Margin="12,9,12,7" CornerRadius="11" ClipToBounds="True"
              BorderBrush="#325A88" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#142947" Offset="0"/>
            <GradientStop Color="#173E6D" Offset="0.58"/>
            <GradientStop Color="#1B548A" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Canvas Opacity="0.28" IsHitTestVisible="False" ClipToBounds="True">
            <Polygon Points="0,109 52,69 77,89 128,35 182,89 235,51 293,104 353,39 425,109 520,109"
                     Fill="#27619C"/>
            <Polygon Points="0,109 80,83 118,98 188,60 251,109 355,67 420,107 560,109" Fill="#1D4679"/>
            <Polygon Points="0,110 43,98 57,77 74,100 135,108 181,87 210,109 300,109 480,108"
                     Fill="#2E72AF" Opacity="0.47"/>
            <Path Data="M0,112 C75,94 140,111 215,106 C320,98 380,105 520,110" Stroke="#0879DC" StrokeThickness="2"/>
          </Canvas>
          <Grid Margin="21,10,19,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.1*" MinWidth="150"/>
              <ColumnDefinition Width="1.05*" MinWidth="105"/>
              <ColumnDefinition Width="1.0*" MinWidth="100"/>
              <ColumnDefinition Width="1.25*" MinWidth="130"/>
              <ColumnDefinition Width="1.08*" MinWidth="100"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding GreetingText}" FontWeight="Bold" FontSize="18"
                         Foreground="{StaticResource V5LightText}"/>
              <TextBlock Text="{Binding ActiveSummaryLabel}" Foreground="#B6CDE8" FontSize="11" Margin="0,5,0,0"/>
              <TextBlock Text="YOUR DOWNLOADS" Foreground="#88B7EB" FontSize="9"
                         FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
              <TextBlock Text="&#xE9D9;" Foreground="#107AF6" FontFamily="{StaticResource V5IconFont}" FontSize="20" Margin="0,0,8,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AggregateSpeedLabel}" Foreground="{StaticResource V5LightText}" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="Current speed" Foreground="{StaticResource V5LightMuted}" FontSize="10"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
              <TextBlock Text="&#xEDA2;" Foreground="#107AF6" FontFamily="{StaticResource V5IconFont}" FontSize="19" Margin="0,0,7,0"/>
              <StackPanel>
                <TextBlock Text="{Binding AggregateTotalSizeLabel}" Foreground="{StaticResource V5LightText}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Total size" Foreground="{StaticResource V5LightMuted}" FontSize="10"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Grid Width="57" Height="57">
                <charts:ProgressRing Value="{Binding AggregateProgressPercent, Mode=OneWay}"/>
                <TextBlock Text="{Binding AggregateProgressLabel}" Foreground="{StaticResource V5LightText}"
                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                <TextBlock Text="{Binding AggregateProgressLabel}" Foreground="{StaticResource V5LightText}" FontWeight="Bold"/>
                <TextBlock Text="Overall progress" Foreground="{StaticResource V5LightMuted}" FontSize="10"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
              <TextBlock Text="&#xE9D2;" Foreground="#137CF9" FontFamily="{StaticResource V5IconFont}" FontSize="21" Margin="0,0,7,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AggregateEtaLabel}" Foreground="{StaticResource V5LightText}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Estimated time left" Foreground="{StaticResource V5LightMuted}" FontSize="10"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Download status tabs and compact actions, styled like the supplied reference. -->
      <Grid Grid.Row="2" Margin="12,3,12,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="275"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ViewTitle" Text="Downloads" Visibility="Collapsed"/>
          <Button x:Name="TabAll" Tag="all" Click="DownloadTab_Click" Style="{StaticResource V5LightTabButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="All" Margin="0,0,5,0"/><TextBlock Text="{Binding DownloadsCount}"/></StackPanel>
          </Button>
          <Button x:Name="TabDownloading" Tag="Downloading" Click="DownloadTab_Click" Style="{StaticResource V5LightTabButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Downloading" Margin="0,0,5,0"/><TextBlock Text="{Binding DownloadingCount}"/></StackPanel>
          </Button>
          <Button x:Name="TabPaused" Tag="Paused" Click="DownloadTab_Click" Style="{StaticResource V5LightTabButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Paused" Margin="0,0,5,0"/><TextBlock Text="{Binding PausedCount}"/></StackPanel>
          </Button>
          <Button x:Name="TabQueued" Tag="Queued" Click="DownloadTab_Click" Style="{StaticResource V5LightTabButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Queued" Margin="0,0,5,0"/><TextBlock Text="{Binding PendingCount}"/></StackPanel>
          </Button>
          <Button x:Name="TabCompleted" Tag="Completed" Click="DownloadTab_Click" Style="{StaticResource V5LightTabButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Completed" Margin="0,0,5,0"/><TextBlock Text="{Binding CompletedCount}"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="Add_Click" Style="{StaticResource V5LightPrimaryButton}" Margin="0,0,7,0" ToolTip="Create a new download">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource V5IconFont}" Foreground="White" Margin="0,0,6,0"/>
              <TextBlock Text="Add Download" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button Click="PasteLink_Click" Style="{StaticResource V5LightToolbarButton}" Margin="0,0,6,0" ToolTip="Paste a URL into New Download">
            <TextBlock Text="&#xE71B;" FontFamily="{StaticResource V5IconFont}" FontSize="14"/>
          </Button>
          <Button Click="Resume_Click" Style="{StaticResource V5LightToolbarButton}" Margin="0,0,6,0" ToolTip="Resume selected">
            <TextBlock Text="&#xE768;" FontFamily="{StaticResource V5IconFont}"/>
          </Button>
          <Button Click="Pause_Click" Style="{StaticResource V5LightToolbarButton}" Margin="0,0,6,0" ToolTip="Pause selected">
            <TextBlock Text="&#xE769;" FontFamily="{StaticResource V5IconFont}"/>
          </Button>
          <Button Click="OpenDownloadsFolder_Click" Style="{StaticResource V5LightToolbarButton}" Margin="0,0,6,0" ToolTip="Open Downloads folder">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource V5IconFont}"/>
          </Button>
          <Button x:Name="MoreFiltersButton" Click="ToggleFilters_Click" Style="{StaticResource V5LightToolbarButton}" ToolTip="More download filters">
            <TextBlock Text="&#xE10C;" FontFamily="{StaticResource V5IconFont}" FontSize="16"/>
          </Button>
          <Popup x:Name="ExtraFilters" PlacementTarget="{Binding ElementName=MoreFiltersButton}"
                 Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#102844" BorderBrush="{StaticResource V5LightBorder}" BorderThickness="1"
                    CornerRadius="7" Padding="12" MinWidth="186">
              <StackPanel>
                <TextBlock Text="Filters" Foreground="{StaticResource V5LightText}" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <ComboBox x:Name="StatusFilter" Width="159" Style="{StaticResource V5Combo}" SelectionChanged="Filters_Changed" SelectedIndex="0" Margin="0,0,0,7">
                  <ComboBoxItem Content="All statuses"/><ComboBoxItem Content="Downloading"/><ComboBoxItem Content="Paused"/>
                  <ComboBoxItem Content="Queued"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Failed"/>
                  <ComboBoxItem Content="Canceled"/>
                </ComboBox>
                <ComboBox x:Name="CategoryFilter" Width="159" Style="{StaticResource V5Combo}" SelectedIndex="0" SelectionChanged="Filters_Changed" Margin="0,0,0,7">
                  <ComboBoxItem Content="All categories"/><ComboBoxItem Content="Software"/><ComboBoxItem Content="Videos"/>
                  <ComboBoxItem Content="Documents"/><ComboBoxItem Content="Archives"/><ComboBoxItem Content="Images"/><ComboBoxItem Content="Other"/>
                </ComboBox>
                <ComboBox x:Name="LabelFilter" Width="159" Style="{StaticResource V5Combo}" SelectedIndex="0" SelectionChanged="Filters_Changed">
                  <ComboBoxItem Content="All labels"/><ComboBoxItem Content="Work"/><ComboBoxItem Content="Personal"/><ComboBoxItem Content="Important"/>
                </ComboBox>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Grid>

      <DataGrid x:Name="DownloadsGrid" Grid.Row="3" Margin="12,0,12,5" 
        ItemsSource="{Binding VisibleDownloads}" SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
        Background="{StaticResource V5LightSurface}" Foreground="{StaticResource V5LightText}"
        BorderBrush="{StaticResource V5LightBorder}" BorderThickness="1"
        HeadersVisibility="Column" GridLinesVisibility="None" ColumnHeaderStyle="{StaticResource V5LightHeader}"
        AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
        RowHeight="55" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
        RowStyle="{StaticResource V5LightGridRow}" CellStyle="{StaticResource V5LightGridCell}"
        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.CanContentScroll="True" AlternatingRowBackground="#112741">
        <DataGrid.Resources>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#163B63"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#163B63"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F0F6FF"/>
          <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F0F6FF"/>
        </DataGrid.Resources>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="32" MinWidth="32">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Select download"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Name" Width="2.6*" MinWidth="195">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" Background="#1D3A5B" CornerRadius="6" Margin="0,0,9,0">
                  <TextBlock Text="{Binding Name, Converter={StaticResource FileIcon}}" 
                             Foreground="{Binding Name, Converter={StaticResource FileIconColor}}"
                             FontFamily="{StaticResource V5IconFont}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" MinWidth="0">
                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource V5LightText}"
                             FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="325"/>
                  <TextBlock Text="{Binding Host}" Foreground="{StaticResource V5LightMuted}" FontSize="10"
                             TextTrimming="CharacterEllipsis" MaxWidth="325"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Progress" Width="1.6*" MinWidth="140">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0" Style="{StaticResource V5LightProgress}" Margin="0,0,7,0"
                             Value="{Binding Percent, Mode=OneWay, TargetNullValue=0}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Foreground="#49AEFF"
                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
              </Grid>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Size" Binding="{Binding TransferredLabel}"
                ElementStyle="{StaticResource V5LightGridText}" Width="1.4*" MinWidth="122"/>
          <DataGridTextColumn Header="Speed" Binding="{Binding SpeedLabel}"
                ElementStyle="{StaticResource V5LightGridText}" Width="1.0*" MinWidth="74"/>
          <DataGridTextColumn Header="ETA" Binding="{Binding EtaLabel}"
                ElementStyle="{StaticResource V5LightGridText}" Width=".85*" MinWidth="68"/>
          <DataGridTemplateColumn Header="Status" Width="1.1*" MinWidth="104">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <Border Background="{Binding Status, Converter={StaticResource LightStatusBackground}}"
                      HorizontalAlignment="Left" CornerRadius="6" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="●" FontSize="10" Margin="0,0,6,0" 
                             Foreground="{Binding Status, Converter={StaticResource LightStatusText}}"/>
                  <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{Binding Status, Converter={StaticResource LightStatusText}}"/>
                </StackPanel>
              </Border>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="" Width="79" MinWidth="79">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="RowQuickAction_Click" Padding="6,4" Background="Transparent"
                        BorderThickness="0" ToolTip="Pause, resume or open completed download">
                  <TextBlock FontFamily="{StaticResource V5IconFont}" FontSize="12"
                             Foreground="#9FC5F3" Text="{Binding Status, Converter={StaticResource DownloadActionGlyph}}"/>
                </Button>
                <Button Click="RowMore_Click" Padding="6,4" Background="Transparent"
                        BorderThickness="0" ToolTip="More actions">
                  <TextBlock Text="&#xE10C;" FontFamily="{StaticResource V5IconFont}" FontSize="13"
                             Foreground="#9FC5F3"/>
                </Button>
              </StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel x:Name="EmptyState" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsHitTestVisible="False" Margin="24" MaxWidth="470">
        <Border Width="66" Height="66" CornerRadius="18" Background="#193D66" HorizontalAlignment="Center" Margin="0,0,0,17">
          <TextBlock Text="&#xE896;" FontFamily="{StaticResource V5IconFont}" FontSize="28" Foreground="#1686F4"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Ready for your next download" FontSize="19" FontWeight="SemiBold"
                   Foreground="{StaticResource V5LightText}" HorizontalAlignment="Center"/>
        <TextBlock Text="Add a direct HTTP or HTTPS link to get started. Your files and download history stay on this device."
                   Foreground="{StaticResource V5LightMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0"/>
      </StackPanel>
      <!-- Selected download inspector: no fictional connection graph -->
      <Border x:Name="InspectorPanel" Grid.Row="4" Visibility="Collapsed" Height="322" Background="{StaticResource V5SurfaceBrush}"
              BorderBrush="{StaticResource V5OutlineBrush}" BorderThickness="1" CornerRadius="9"
              Margin="0,11,0,0" Padding="15">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="4,0,0,9">
            <TextBlock Text="{Binding SelectedDownload.Name, TargetNullValue=Select a download}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedDownload.Status}" Margin="15,4,0,0" Foreground="{StaticResource V5AccentLightBrush}"/>
          </StackPanel>
          <TabControl Grid.Row="1" Background="{StaticResource V5SurfaceBrush}" BorderThickness="0" Style="{StaticResource V5TabControl}">
            <TabItem Header="Overview">
              <Grid Margin="5,11,5,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.15*" MinWidth="175"/>
                  <ColumnDefinition Width="1.75*" MinWidth="280"/>
                  <ColumnDefinition Width="1.1*" MinWidth="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="5,0,12,0">
                  <TextBlock Text="TRANSFER DETAILS" FontSize="10" Foreground="{StaticResource V5MutedBrush}" Margin="0,0,0,8"/>
                  <TextBlock Text="{Binding SelectedDownload.Status, StringFormat='Status: {0}'}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                  <TextBlock Text="{Binding SelectedDownload.TransferredLabel}" Foreground="{StaticResource V5TextBrush}" Margin="0,0,0,7"/>
                  <ProgressBar Style="{StaticResource V5ProgressFixed}" Maximum="100"
                    Value="{Binding SelectedDownload.Percent, Mode=OneWay, TargetNullValue=0}"
                    IsIndeterminate="{Binding SelectedDownload.IsIndeterminate, Mode=OneWay}"/>
                  <TextBlock Text="{Binding SelectedDownload.ProgressLabel}" Foreground="{StaticResource V5MutedBrush}" Margin="0,4,0,8"/>
                  <TextBlock Text="{Binding SelectedDownload.SpeedLabel, StringFormat='Speed: {0}'}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding SelectedDownload.EtaLabel, StringFormat='ETA: {0}'}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding SelectedDownload.Connections, StringFormat='Connections: {0}'}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding SelectedDownload.Category, StringFormat='Category: {0}'}" Margin="0,0,0,6"/>
                  <TextBlock Text="{Binding SelectedDownload.Destination}" Foreground="{StaticResource V5AccentLightBrush}"
                             FontSize="10" ToolTip="{Binding SelectedDownload.Destination}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SelectedDownload.Error}" Foreground="{StaticResource V5DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,13,0">
                  <Grid Margin="0,0,0,7">
                    <TextBlock Text="Connection activity" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{Binding SelectedDownload.SpeedLabel}" HorizontalAlignment="Right"
                        Foreground="{StaticResource V5AccentLightBrush}" FontWeight="SemiBold"/>
                  </Grid>
                  <charts:SpeedGraph Source="{Binding SelectedDownload}" Height="98" Margin="0,0,0,12"/>
                  <TextBlock Text="{Binding SelectedDownload.Connections, StringFormat='Active workers: {0}'}"
                             Foreground="{StaticResource V5MutedBrush}" Margin="0,0,0,7"/>
                  <Border BorderBrush="{StaticResource V5OutlineBrush}" BorderThickness="1"
                          CornerRadius="5" Background="{StaticResource V5ElevatedBrush}" Padding="9">
                    <Grid>
                      <TextBlock Text="{Binding SelectedDownload.Connections, StringFormat='Active range workers: {0}'}" FontSize="11"/>
                      <TextBlock Text="{Binding SelectedDownload.SpeedLabel}" HorizontalAlignment="Right"
                          Foreground="{StaticResource V5AccentLightBrush}"/>
                    </Grid>
                  </Border>
                  <TextBlock Text="Only active, measured network traffic is charted."
                             FontSize="10" Foreground="{StaticResource V5MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Transfer rules" FontWeight="SemiBold" Margin="0,0,0,9"/>
                  <TextBlock Text="{Binding SelectedDownload.RequestedConnections, StringFormat='Requested workers: {0}'}" Foreground="{StaticResource V5MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                  <TextBlock Text="Resume: validated HTTP ranges" Foreground="{StaticResource V5MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                  <TextBlock Text="Checksum: not configured" Foreground="{StaticResource V5MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                  <TextBlock Text="Verified HTTP ranges and strong ETag required" Foreground="{StaticResource V5MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Open file" Click="OpenFile_Click" Padding="8,7" Style="{StaticResource V5ToolbarButton}"/>
                    <Button Content="Folder" Click="OpenFolder_Click" Padding="8,7" Style="{StaticResource V5ToolbarButton}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </TabItem>
            <TabItem Header="Connections">
              <StackPanel Margin="12">
                <TextBlock Text="{Binding SelectedDownload.Connections, StringFormat='Active connections: {0}'}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedDownload.SpeedLabel, StringFormat='Current speed: {0}'}" Margin="0,10,0,0"/>
                <TextBlock Text="Connection count is the current number of active streams; unsupported servers fall back to one direct stream."
                           Foreground="{StaticResource V5MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </TabItem>
            <TabItem Header="Segments (planned)" IsEnabled="False"/>
            <TabItem Header="Graph">
              <Grid Margin="8,12">
                <charts:SpeedGraph Source="{Binding SelectedDownload}"/>
              </Grid>
            </TabItem>
            <TabItem Header="Log">
              <ScrollViewer Margin="8,12" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedDownload.Events}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                 Margin="0,0,0,6" Foreground="{StaticResource V5MutedBrush}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <TextBlock Grid.Row="5" x:Name="StatusMessage" Foreground="{StaticResource V5MutedBrush}" Margin="3,8,0,0"
                 Text="Ready. Local-first downloads • RangeDesk v5 preview"/>
    </Grid>

    <!-- Approved new-download modal, connected to real download requests -->
    <Grid x:Name="AddOverlay" Grid.ColumnSpan="2" Panel.ZIndex="8" Background="#BB030B1A" Visibility="Collapsed">
      <Border Width="435" MaxHeight="680" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,17,0"
              Background="{StaticResource V5ElevatedBrush}" BorderBrush="{StaticResource V5OutlineBrush}"
              BorderThickness="1" CornerRadius="10" Padding="18">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="CloseAdd_Click" Style="{StaticResource V5ToolbarButton}"/>
            <Button Content="▶  Start Download" Click="StartDownload_Click" Style="{StaticResource V5PrimaryButton}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="↓   New Download" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <TabControl Background="{StaticResource V5ElevatedBrush}" BorderThickness="0" Style="{StaticResource V5TabControl}">
              <TabItem Header="General">
                <StackPanel Margin="7,18,7,7">
                  <TextBlock Text="URL (HTTP or HTTPS)" Foreground="{StaticResource V5MutedBrush}"/>
                  <TextBox x:Name="NewUrl" Style="{StaticResource V5Input}" Margin="0,7,0,15" TextChanged="Url_Changed"/>
                  <TextBlock Text="Save to (complete file path)" Foreground="{StaticResource V5MutedBrush}"/>
                  <Grid Margin="0,7,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NewDestination" Style="{StaticResource V5Input}"/>
                    <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Style="{StaticResource V5ToolbarButton}" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="Category" Foreground="{StaticResource V5MutedBrush}"/>
                  <ComboBox x:Name="NewCategory" Style="{StaticResource V5Combo}" SelectedIndex="0" Margin="0,7,0,12">
                    <ComboBoxItem Content="Other"/><ComboBoxItem Content="Software"/><ComboBoxItem Content="Videos"/>
                    <ComboBoxItem Content="Documents"/><ComboBoxItem Content="Archives"/><ComboBoxItem Content="Images"/>
                  </ComboBox>
                  <TextBlock Text="Labels (optional, comma-separated)" Foreground="{StaticResource V5MutedBrush}" Margin="0,0,0,7"/>
                  <TextBox x:Name="NewLabels" Style="{StaticResource V5Input}" Margin="0,0,0,12"
                           ToolTip="Example: Work, Important"/>
                  <CheckBox x:Name="QueueOnly" Content="Add to queue without starting" Margin="0,0,0,12"/>
                  <TextBlock Text="This preview stores downloads locally. Your existing destination files will never be replaced automatically."
                             Foreground="{StaticResource V5MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </TabItem>
              <TabItem Header="Advanced"><StackPanel Margin="8,17">
                <TextBlock Text="Maximum connections per download" Foreground="{StaticResource V5MutedBrush}" Margin="0,0,0,8"/>
                <ComboBox x:Name="ConnectionChoice" Style="{StaticResource V5Combo}" Width="180" HorizontalAlignment="Left" SelectedIndex="3" Margin="0,0,0,10">
                  <ComboBoxItem Content="1 connection" Tag="1"/>
                  <ComboBoxItem Content="2 connections" Tag="2"/>
                  <ComboBoxItem Content="4 connections" Tag="4"/>
                  <ComboBoxItem Content="8 connections" Tag="8"/>
                  <ComboBoxItem Content="16 connections" Tag="16"/>
                  <ComboBoxItem Content="32 connections" Tag="32"/>
                </ComboBox>
                <TextBlock Text="Uses multiple validated byte ranges only when the server supports HTTP 206 and a strong ETag; otherwise safely downloads with one connection. Your selected maximum is not a guarantee."
                           TextWrapping="Wrap" Foreground="{StaticResource V5MutedBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Resume uses per-segment files with strong ETag validation. Speed limits and scheduling remain separate features."
                           TextWrapping="Wrap" Foreground="{StaticResource V5MutedBrush}"/>
              </StackPanel></TabItem>
              <TabItem Header="Rules (planned)" IsEnabled="False"/>
              <TabItem Header="Automation (planned)" IsEnabled="False"/>
            </TabControl>
            <TextBlock x:Name="FormError" Foreground="{StaticResource V5DangerBrush}" TextWrapping="Wrap" Margin="7,6,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Panel.ZIndex="9" Background="#BB030B1A" Visibility="Collapsed">
      <Border Width="510" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource V5ElevatedBrush}" BorderBrush="{StaticResource V5OutlineBrush}"
              BorderThickness="1" CornerRadius="9" Padding="22">
        <StackPanel>
          <TextBlock Text="⚙   RangeDesk Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
          <TextBlock Text="Independent, local-first Windows download manager."/>
          <TextBlock Text="RangeDesk can run two downloads concurrently. Each download can request 1–32 range connections when the server safely supports them."
                     Foreground="{StaticResource V5MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <TextBlock Text="Automatic segment redistribution, shared bandwidth limits, scheduled queues, and browser capture are not yet ready for release."
                     Foreground="{StaticResource V5MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,17"/>
          <Button Content="Close" Click="CloseSettings_Click" Style="{StaticResource V5PrimaryButton}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
